# CVAT Configuration Template
# Copy this file to .env and fill in your actual values

# CVAT Connection Settings
CVAT_HOST=http://localhost:8080
CVAT_USERNAME=your_cvat_username
CVAT_PASSWORD=your_cvat_password

# PostgreSQL Database Configuration
DB_NAME=cvat_annotations_db
DB_USER=admin
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=55432

# Note: CVAT_USERNAME and CVAT_PASSWORD are required.
# All other variables have default values that will be used if not specified.